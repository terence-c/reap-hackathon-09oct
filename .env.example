# Copy to .env.local and fill in. Never commit .env.local.

# --- Reap sandbox (Role A) ---
REAP_API_KEY=
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_API_VERSION=2025-02-14     # Reap-Version header, from Reap's API reference
REAP_ENROLLMENT_ID=              # produced by `npm run enroll`, not given by Reap

# --- App ---
APP_BASE_URL=http://localhost:3000   # swap for your ngrok https URL before testing checkout
DEMO_EMAIL=demo@agentcart.test

# --- SAFR agent identity (Role B) ---
AGENT_ID=purchasing-agent-v1
AGENT_PRIVATE_KEY=               # produced by `npm run keygen`

# --- LLM (Role C) — any OpenAI-compatible endpoint ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1      # change for OpenRouter, Groq, a local server, etc.
OPENAI_MODEL=gpt-6-luna                        # must support tool calling
