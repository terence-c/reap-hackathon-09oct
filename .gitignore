# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite (SAFR audit log, registry) — runtime state, per developer
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# keys (agent private key belongs in .env.local only)
*.key

# logs
*.log
/logs/

# editors
.vscode/
.idea/
*.swp

# personal AI-agent settings
.claude/settings.local.json

# not shared via git
package-lock.json
/TODO-*.md
/AGENTS.md

# next dev --experimental-https (mkcert) local certs
/certificates/
